-- Models/Swords/New Silhouettes/profiles.py from the traced sheets; BladeData appends them after every other blade.
-- Edit the script and regenerate rather than this file. Units are centimetres. P{u, v, ...} / T{u, a, b, ...} are flat
-- lists of points, rebuilt into { { u, v }, ... } here.
local function P(t: { number }): { { number } }
	local out = {}
	for i = 1, #t, 2 do
		table.insert(out, { t[i], t[i + 1] })
	end
	return out
end
local function T(t: { number }): { { number } }
	local out = {}
	for i = 1, #t, 3 do
		table.insert(out, { t[i], t[i + 1], t[i + 2] })
	end
	return out
end
